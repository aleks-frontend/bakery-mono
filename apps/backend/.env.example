PORT=3001
DATABASE_URL=postgresql://bakery:bakery@localhost:5432/bakery

# Better Auth (added in Phase 4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# Single admin account, provisioned by `npm run prisma:seed -w @bakery/backend`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transactional email (added in Phase 10)
RESEND_API_KEY=
EMAIL_FROM=Liszt Rapszódia <orders@lisztrapszodia.in.rs>
ADMIN_NOTIFICATION_EMAIL=order@lisztrapszodia.in.rs

# Error tracking (Sentry) — same DSN works across all three apps' SDKs, it's a
# per-project identifier, not a secret. Leave unset to disable (no-op).
SENTRY_DSN=

# Baker notification on new order (added in Phase 14), sent alongside the
# admin alert email. Leave unset to disable (no-op).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI-generated holiday messages (Close Ordering / Edit Holiday Message modals,
# admin panel). AI_HOLIDAY_MESSAGE_MODEL is provider:model; only `openai` is
# supported. Always pin a dated snapshot (e.g. gpt-5.4-mini-2026-03-17), never
# a floating alias, so the output can't change under us, and add that snapshot
# to the OpenAI project's model allow-list or every call fails. Use the
# "bakery" OpenAI project's keys: a personal dev key locally, a service-account
# key in production. Unlike the integrations above, this powers a
# user-triggered action rather than a fire-and-forget notification, so a
# missing value returns an error to the admin panel instead of silently
# no-opping.
AI_HOLIDAY_MESSAGE_MODEL=openai:gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
